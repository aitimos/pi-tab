{
  "name": "pi-tab",
  "version": "1.5.2",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "bookmarklet": "node make-bookmarklet.mjs",
    "start": "node relay.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:extension": "node scripts/test-extension-ui.mjs",
    "test:tabs": "node scripts/test-extension-tabs.mjs && node scripts/test-continuations.mjs && node scripts/test-history-index.mjs && node scripts/test-worker-recovery.mjs && node scripts/test-draft-recovery.mjs",
    "test:bookmarklet": "node scripts/test-bookmarklet-ui.mjs",
    "test:i18n": "node scripts/test-i18n-ui.mjs",
    "test:stop": "node scripts/test-stop-markdown.mjs",
    "test:queue": "node scripts/test-message-queue.mjs",
    "test:oauth": "node scripts/test-oauth.mjs",
    "test:mcp": "node scripts/test-mcp-ui.mjs",
    "test:management": "node scripts/test-management.mjs && node scripts/test-model-settings-ui.mjs && node scripts/test-model-provider-ui.mjs && node scripts/test-model-auth-recovery.mjs",
    "test:model-settings": "node scripts/test-model-settings-ui.mjs",
    "test:model-providers": "node scripts/test-model-provider-ui.mjs",
    "test:model-auth": "node scripts/test-model-auth-recovery.mjs",
    "build:linux": "bash scripts/build-linux.sh",
    "test:linux": "node scripts/test-linux-runtime.mjs",
    "test:linux-tools": "node scripts/test-extension-linux.mjs",
    "test:continuations": "node scripts/test-continuations.mjs",
    "test:history": "node scripts/test-history-index.mjs",
    "test:worker": "node scripts/test-worker-recovery.mjs",
    "test:drafts": "node scripts/test-draft-recovery.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "marked": "18.1.2",
    "picomatch": "4.0.7",
    "sval": "0.6.12",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@radix-ui/colors": "3.0.0",
    "agent-browser": "0.34.0",
    "esbuild": "0.25.12",
    "playwright": "1.57.0",
    "terser": "5.44.1"
  }
}
